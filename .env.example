# FlowWallet environment template.
# Copy to `.env` (which is git-ignored) and fill in real values:  cp .env.example .env
# Local defaults below work out of the box; you MUST set the Stripe keys for payments.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Single source of truth: Docker Compose provisions Postgres with these, and the
# services' datasource reads the same variables.
POSTGRES_USER=flowadmin
POSTGRES_PASSWORD=change-me

# ── Kafka ─────────────────────────────────────────────────────────────────────
# KRaft cluster id (generate one with: docker run --rm apache/kafka:3.8.0 /opt/kafka/bin/kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=change-me

# ── Application ports ─────────────────────────────────────────────────────────
GATEWAY_PORT=8080
WALLET_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082

# ── Database connection pool (HikariCP) ───────────────────────────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Stripe (test keys from the Stripe dashboard) ──────────────────────────────
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ── Outbox tuning ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=3

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# ── Kafka security (uncomment & configure for non-local brokers) ──────────────
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="..." password="...";

# === Top-up limits (Payment Service) ===
# Commercial bounds on one top-up, in major currency units. Startup fails if min exceeds max.
PAYMENT_MIN_TOP_UP_AMOUNT=1.00
PAYMENT_MAX_TOP_UP_AMOUNT=10000.00

# === Optimistic-lock retry (Payment Service) ===
PAYMENT_OPTIMISTIC_LOCK_MAX_ATTEMPTS=3
PAYMENT_OPTIMISTIC_LOCK_BACKOFF_MS=50

# === Outbox tuning (the rest lives above) ===
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_CRON=0 0 3 * * *
OUTBOX_REAPER_INTERVAL_MS=60000
OUTBOX_RETRY_BACKOFF_BASE_MS=1000
OUTBOX_RETRY_BACKOFF_MAX_MS=60000
OUTBOX_STUCK_PROCESSING_THRESHOLD_MS=300000

# === Stripe ===
# Clock-skew allowance when verifying a webhook signature. Too small and a drifting
# host starts refusing genuine deliveries, which looks like payments that never credit.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# === Gateway CORS ===
# "*" is fine for local work and wrong for anything public.
GATEWAY_CORS_ALLOWED_ORIGINS=*
GATEWAY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
GATEWAY_CORS_ALLOWED_HEADERS=*

# === Actuator ===
# /actuator/outbox can requeue events, so trim this list on a public deployment.
ACTUATOR_EXPOSED_ENDPOINTS=health,info,metrics,outbox

# === Database and logging detail ===
PAYMENT_DB_NAME=payment_db
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
KAFKA_CLIENT_LOG_LEVEL=ERROR
KAFKA_CONFIG_LOG_LEVEL=WARN

# === Host ports for docker compose ===
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090
