# ─────────────────────────────────────────────────────────────────────────────
#  FlowWallet — environment template
#
#    cp .env.example .env
#
#  Fill in the values under REQUIRED. Everything after that already works as
#  written — change it only when you have a reason. Your .env is git-ignored.
#
#  Read by Docker Compose AND by all three services, so each value lives in one
#  place. Exported environment variables override it. Do not quote values: the
#  services read this file as .properties, where quotes become part of the value.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Stripe secret key — https://dashboard.stripe.com/test/apikeys
# Without it the application starts but no payment can be created. A key that
# is not a test-mode key (sk_test_ or rk_test_) fails startup: FlowWallet opens
# connected accounts with a fake identity and never runs against live Stripe.
STRIPE_API_KEY=sk_test_your_key_here

# Webhook signing secret. NOT on the API keys page: for local development it is
# printed by `stripe listen` when it starts; for a registered endpoint it is on
# https://dashboard.stripe.com/test/webhooks. Leave it empty until you have it.
# While it is empty, a placeholder or not a whsec_ value, the service starts but
# refuses every webhook with 400, and a paid deposit is credited only when the
# reconciler finds it, 15 minutes or more later. A wrong whsec_ value also gets
# every genuine webhook a 400.
STRIPE_WEBHOOK_SECRET=

# Signing secret of the endpoint for connected accounts (payouts and bank
# accounts), /api/payments/webhooks/stripe/connect. `stripe listen` signs both
# targets with one secret, so locally it is the same value as
# STRIPE_WEBHOOK_SECRET; a registered Connect endpoint has a secret of its own.
# While it is empty, a placeholder or not a whsec_ value, every Connect webhook
# gets 400 and payouts settle only when the payout reconciler asks Stripe
# (docs/adr/0036-connect-webhooks-have-their-own-endpoint-and-secret.md).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Database password. Compose provisions Postgres with it and the services read
# the same variable, so it only has to be right in one place.
POSTGRES_PASSWORD=change-me


# ── Ports ────────────────────────────────────────────────────────────────────

# Where each service listens.
GATEWAY_PORT=8080
WALLET_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082

# The interface each service binds to. 127.0.0.1 keeps their unauthenticated API and actuator off the LAN
# when run directly on this host. Set them to 0.0.0.0 only inside a container, where the loopback address
# would not be reachable from another container or from the host at all. The gateway forwards X-User-Id as
# the client sent it, so it may listen wider only behind an authentication layer that sets the header; it
# logs a WARN at startup when it does (docs/adr/0031-callers-are-authenticated-in-front-of-the-gateway.md).
GATEWAY_ADDRESS=127.0.0.1
WALLET_SERVICE_ADDRESS=127.0.0.1
PAYMENT_SERVICE_ADDRESS=127.0.0.1

# How long the gateway waits for an upstream to answer and to connect, so a request to an upstream that
# accepts the connection and never answers does not hang forever on the elastic Netty pool. 20s sits above
# Wallet Service's own worst case for a call to Payment Service (WALLET_PAYMENT_CONNECT_TIMEOUT +
# WALLET_PAYMENT_READ_TIMEOUT below), so that timeout fires first in the ordinary case. Millis, not a
# duration string: Spring Cloud Gateway's connect-timeout binds to a plain integer.
GATEWAY_HTTPCLIENT_RESPONSE_TIMEOUT=20s
GATEWAY_HTTPCLIENT_CONNECT_TIMEOUT_MS=2000

# Where compose publishes infrastructure on the host. Change these when
# something else already holds the port.
DB_PORT=5432
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090

# Gateway route targets. The defaults follow the service ports above, so
# setting these is only needed when a service runs somewhere else entirely.
# WALLET_SERVICE_URI=http://localhost:8081
# PAYMENT_SERVICE_URI=http://localhost:8082


# ── Database ─────────────────────────────────────────────────────────────────

POSTGRES_USER=flowadmin
DB_HOST=localhost
PAYMENT_DB_NAME=payment_db
WALLET_DB_NAME=wallet_db

# HikariCP pool.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# How long a request waits for a pooled connection, in milliseconds. Keep it below
# GATEWAY_HTTPCLIENT_RESPONSE_TIMEOUT and WALLET_PAYMENT_READ_TIMEOUT: a dead database then
# reaches the caller as the service's 503 (retry with the same key) and not as a timeout
# further up.
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Postgres' DETAIL line in exception messages. Off by default. true puts user ids and
# balances into the logs (a duplicate key's values, a refused row), so turn it on only
# for local debugging.
# DB_LOG_SERVER_ERROR_DETAIL=true


# ── Kafka ────────────────────────────────────────────────────────────────────

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic geometry, applied when the topic is first created. Changing the
# partition count later does not reshape an existing topic.
# Consumer geometry for Wallet Service. The topic name itself is not configurable —
# it is a compile-time constant in flow-wallet-contract, shared by producer and consumer.
KAFKA_CONSUMER_GROUP_ID=flow-wallet-service
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
KAFKA_LISTENER_CONCURRENCY=3

# Where Wallet Service reaches Payment Service to start a deposit and to relay a bank account. Direct, not
# through the gateway. A bank account request makes up to four Stripe calls and can outlast the read
# timeout; the wallet then answers 502, and the retry with the same token is safe.
# A wedged Payment Service is worse than a dead one -- it accepts the connection and never answers -- so
# the read timeout is the only thing that ends the wait. Left unset, it follows PAYMENT_SERVICE_PORT.
# WALLET_PAYMENT_BASE_URL=http://localhost:8082
# Both timeouts must be at least 1ms, and STRIPE is the only provider; anything else fails startup.
WALLET_PAYMENT_CONNECT_TIMEOUT=2s
WALLET_PAYMENT_READ_TIMEOUT=10s
WALLET_PAYMENT_PROVIDER=STRIPE

# How hard Wallet Service retries a record before dead-lettering it. Retries are for failures a later
# attempt can resolve; a deterministically failing record exhausts them and lands on
# payment.events.wallet.DLT, which is the intended end rather than a fault. The backoff sleeps on the
# consumer thread without polling, so the max interval may not exceed 60000, well below Kafka's
# max.poll.interval.ms of 300000.
WALLET_CONSUMER_RETRY_MAX_ATTEMPTS=3
WALLET_CONSUMER_RETRY_INITIAL_INTERVAL_MS=500
WALLET_CONSUMER_RETRY_MAX_INTERVAL_MS=10000
WALLET_CONSUMER_RETRY_MULTIPLIER=2.0

# Payment Service's consumer of wallet.withdrawals, under names of its own:
# both services read this file, and a shared group id would mix their
# consumers. A command that keeps failing goes to wallet.withdrawals.payment.DLT
# after these retries, which have the same bounds as the wallet's.
PAYMENT_KAFKA_CONSUMER_GROUP_ID=flow-wallet-payment
PAYMENT_KAFKA_LISTENER_CONCURRENCY=3
PAYMENT_CONSUMER_RETRY_MAX_ATTEMPTS=3
PAYMENT_CONSUMER_RETRY_INITIAL_INTERVAL_MS=500
PAYMENT_CONSUMER_RETRY_MAX_INTERVAL_MS=10000
PAYMENT_CONSUMER_RETRY_MULTIPLIER=2.0

# Applied when payment.events is created; an existing topic keeps its settings.
# min.insync.replicas decides how many replicas must hold a record before an
# acks=all send succeeds. Keep it at 1 for a single broker; a three-broker
# cluster uses 3 replicas with 2 in sync. It may not exceed the replicas.
KAFKA_TOPIC_PAYMENT_EVENTS_PARTITIONS=3
KAFKA_TOPIC_PAYMENT_EVENTS_REPLICAS=1
KAFKA_TOPIC_PAYMENT_EVENTS_MIN_INSYNC_REPLICAS=1

# Wallet Service's own dead-letter topic, payment.events.wallet.DLT.
KAFKA_TOPIC_PAYMENT_EVENTS_DLT_PARTITIONS=3
KAFKA_TOPIC_PAYMENT_EVENTS_DLT_REPLICAS=1

# wallet.withdrawals, which Wallet Service declares as its producer. Partitions
# and replicas apply when the topic is created; later, only a higher partition
# count is applied. Wallet Service sets modify-topic-configs, so a changed
# min.insync.replicas also reaches an existing topic. Its rules are the same as
# for payment.events.
KAFKA_TOPIC_WALLET_WITHDRAWALS_PARTITIONS=3
KAFKA_TOPIC_WALLET_WITHDRAWALS_REPLICAS=1
KAFKA_TOPIC_WALLET_WITHDRAWALS_MIN_INSYNC_REPLICAS=1

# Payment Service's own dead-letter topic, wallet.withdrawals.payment.DLT,
# which keeps its records without a time limit. Applied when the topic is
# created; later, only a higher partition count is applied, because Payment
# Service does not set modify-topic-configs.
KAFKA_TOPIC_WALLET_WITHDRAWALS_DLT_PARTITIONS=3
KAFKA_TOPIC_WALLET_WITHDRAWALS_DLT_REPLICAS=1

# For a broker outside compose. Leave commented for local work.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="..." password="...";


# ── Deposits ─────────────────────────────────────────────────────────────────

# Commercial bounds on a single deposit, in major currency units. These are
# policy, not arithmetic — a risk team tightens them, a regulator moves them.
# Startup fails if the minimum exceeds the maximum.
PAYMENT_MIN_DEPOSIT_AMOUNT=1.00
PAYMENT_MAX_DEPOSIT_AMOUNT=10000.00

# Two webhooks touching one transaction collide on the version check; this
# governs the retry that follows.
PAYMENT_OPTIMISTIC_LOCK_MAX_ATTEMPTS=3
PAYMENT_OPTIMISTIC_LOCK_BACKOFF_MS=50


# ── Stripe behaviour ─────────────────────────────────────────────────────────

# How long Payment Service waits for Stripe, and how often stripe-java retries
# a failed call under the same idempotency key. Keep (1 + retries) x (connect +
# read), plus stripe-java's backoff of 0.5s doubling per retry, below
# WALLET_PAYMENT_READ_TIMEOUT, or Stripe calls keep running after the wallet has
# answered its caller. Three such calls plus 20s must fit the payout executor's
# lease below.
# Timeouts must be at least 1ms and retries not negative, or startup fails.
STRIPE_API_CONNECT_TIMEOUT=2s
STRIPE_API_READ_TIMEOUT=6s
STRIPE_API_MAX_NETWORK_RETRIES=0

# Payment methods a deposit can be paid with, comma-separated. Only `card` is
# known: delayed and redirect-based methods are left out on purpose. Any other
# name, or an empty value, fails startup.
STRIPE_PAYMENT_METHOD_TYPES=card

# Clock-skew allowance when verifying a webhook signature, on both endpoints.
# Too small and a drifting host starts refusing genuine deliveries, which shows
# up as payments that credit only when the reconciler finds them and payouts
# that settle only when the payout reconciler asks. Must be greater than zero,
# or startup fails.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Largest webhook body accepted; a larger one gets 413 before its signature is
# checked. Between 1B and 16MB, or startup fails.
PAYMENT_WEBHOOK_MAX_PAYLOAD_SIZE=256KB

# Re-checks deposits whose webhook may have been lost: a run every interval asks
# Stripe about deposits still PENDING (or FAILED after a decline) that are older
# than MIN_AGE and younger than MAX_AGE, at most BATCH_SIZE per run, and asks
# about the same one again only after MIN_AGE. The interval is at least 1000 ms,
# MIN_AGE must be shorter than MAX_AGE, and the batch at least 1, or startup
# fails (docs/adr/0032-pending-payments-are-rechecked-with-the-provider.md).
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_MIN_AGE=15m
PAYMENT_RECONCILIATION_MAX_AGE=24h
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# false stops every scheduled job in Payment Service: the outbox poller, reaper
# and cleanup, the reconciler, the payout executor and the payout reconciler.
# The send right after a commit still runs, but a send that fails is never
# retried, a lost webhook is never recovered and no payout moves. Only for a
# test that drives those steps itself.
PAYMENT_SCHEDULING_ENABLED=true

# The currency a withdrawal is paid out in and its minimum. 1.0 offers PLN only,
# from 5.00, the smallest PLN payout Stripe documents. Another currency needs an
# entry of its own in application.yml. An unknown or lower-case code, and a
# minimum that is not positive, off the payout grid or below Stripe's minimum
# payout where StripePayoutMinimums lists one, fail startup.
PAYMENT_PAYOUT_CURRENCY=PLN
PAYMENT_PAYOUT_MIN_AMOUNT=5.00

# How the payout executor works the Transfer, Payout and Reversal steps.
# ENABLED=false stops it, so no payout moves. It runs every INTERVAL_MS,
# claiming at most BATCH_SIZE payouts and none once RUN_BUDGET is spent. A claim
# owns a row for the LEASE; startup fails unless the lease covers three Stripe
# calls under the STRIPE_API_* timeouts and retries plus two 10s margins (44s
# with the defaults), so raising those may need a longer lease. An unknown
# outcome waits UNKNOWN_BACKOFF, doubled per try up to UNKNOWN_MAX_BACKOFF, and
# goes to an operator after UNKNOWN_ATTEMPTS tries in all. A payout refused for
# funds or a limit is tried at most PAYOUT_RETRY_ATTEMPTS times in all,
# PAYOUT_RETRY_INTERVAL apart, before the transfer is reversed; a refused
# reversal at most REVERSAL_RETRY_ATTEMPTS times, REVERSAL_RETRY_INTERVAL apart,
# before an operator takes over. The three limits count the same tries, the
# first included. An interval below 1000 ms, a batch or a limit below 1, a run
# budget or a retry interval below 1s, a lease below 10s, an unknown backoff
# below 30s or above its maximum fail startup. Outcomes are counted in
# payment.payouts.executor.outcomes, hand-overs to an operator in
# payment.payouts.needs.attention, the payouts waiting for one in the gauge
# payment.payouts.awaiting.operator (tag from) and an operator's actions in
# payment.payouts.operator.actions (tags action, outcome). The payouts endpoint
# waits UNKNOWN_BACKOFF after a hand-over before it returns or reverses one.
PAYMENT_PAYOUT_EXECUTOR_ENABLED=true
PAYMENT_PAYOUT_EXECUTOR_INTERVAL_MS=10000
PAYMENT_PAYOUT_EXECUTOR_BATCH_SIZE=20
PAYMENT_PAYOUT_EXECUTOR_RUN_BUDGET=60s
PAYMENT_PAYOUT_EXECUTOR_LEASE=2m
PAYMENT_PAYOUT_EXECUTOR_UNKNOWN_BACKOFF=1m
PAYMENT_PAYOUT_EXECUTOR_UNKNOWN_MAX_BACKOFF=1h
PAYMENT_PAYOUT_EXECUTOR_UNKNOWN_ATTEMPTS=13
PAYMENT_PAYOUT_EXECUTOR_PAYOUT_RETRY_INTERVAL=2h
PAYMENT_PAYOUT_EXECUTOR_PAYOUT_RETRY_ATTEMPTS=13
PAYMENT_PAYOUT_EXECUTOR_REVERSAL_RETRY_INTERVAL=30m
PAYMENT_PAYOUT_EXECUTOR_REVERSAL_RETRY_ATTEMPTS=13

# Settles payouts whose Connect webhook may have been lost. ENABLED=false stops
# it. A run every INTERVAL_MS asks Stripe about at most BATCH_SIZE payouts, one
# read each, and stops once RUN_BUDGET is spent: created payouts first, from
# CREATED_MIN_AGE on and at most that often, then paid ones every PAID_RECHECK
# for PAID_PERIOD after they were paid, because Stripe can fail a paid payout
# days later. An interval below 1000 ms, a batch below 1, a budget or an age
# below 1s, or a PAID_RECHECK not shorter than PAID_PERIOD fail startup.
# Outcomes are counted in payment.payouts.reconciler.outcomes
# (docs/adr/0036-connect-webhooks-have-their-own-endpoint-and-secret.md).
PAYMENT_PAYOUT_RECONCILER_ENABLED=true
PAYMENT_PAYOUT_RECONCILER_INTERVAL_MS=60000
PAYMENT_PAYOUT_RECONCILER_BATCH_SIZE=50
PAYMENT_PAYOUT_RECONCILER_RUN_BUDGET=60s
PAYMENT_PAYOUT_RECONCILER_CREATED_MIN_AGE=15m
PAYMENT_PAYOUT_RECONCILER_PAID_RECHECK=6h
PAYMENT_PAYOUT_RECONCILER_PAID_PERIOD=10d


# ── Outbox ───────────────────────────────────────────────────────────────────

# Both services have an outbox and read these values: Payment Service for its
# payment events, Wallet Service for its withdrawal commands.

# false stops Wallet Service's scheduled jobs, the outbox poller, reaper and
# cleanup. The send right after a commit still runs, but a command whose send
# fails is never retried. Only for a test that drives those steps itself.
WALLET_SCHEDULING_ENABLED=true

# How often the fallback poller looks for events the fast path missed, and how
# many it takes at a time.
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_BATCH_SIZE=50

# Retry schedule for a failed send: base doubles each attempt up to max, and
# the row is marked FAILED after max-retries attempts, the first send included.
# Ten attempts wait about four minutes in backoff (1, 2, 4, 8, 16, 32 s, then
# 60 s three times), plus the poll interval and each send's own wait on the
# broker. Startup fails on a value below 1 or a base above the max.
OUTBOX_MAX_RETRIES=10
OUTBOX_RETRY_BACKOFF_BASE_MS=1000
OUTBOX_RETRY_BACKOFF_MAX_MS=60000

# A sender that dies mid-send leaves a row claimed. The reaper releases it —
# but the threshold must stay well above the longest possible single send, or
# it will reset a row that is still in flight and the event goes out twice.
OUTBOX_REAPER_INTERVAL_MS=60000
OUTBOX_STUCK_PROCESSING_THRESHOLD_MS=300000

# How long completed rows are kept, and when the sweep runs. FAILED rows are never
# swept -- an undelivered event is the only record of it; requeue it via /actuator/outbox.
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_CRON=0 0 3 * * *


# ── Gateway CORS ─────────────────────────────────────────────────────────────

# "*" is right for local work and wrong for anything reachable from outside.
GATEWAY_CORS_ALLOWED_ORIGINS=*
GATEWAY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
GATEWAY_CORS_ALLOWED_HEADERS=*


# ── Observability ────────────────────────────────────────────────────────────

# Left commented on purpose. Every service reads this file, and each has its
# own default: payment and wallet health,info,metrics,outbox; gateway
# health,info. A value set here applies to all three at once.
# /actuator/outbox can requeue events, so trim the list on a public deployment.
# /actuator/payouts exists in Payment Service and is in no default: its writes
# credit wallets and it authenticates nobody. Export it for the one Payment
# Service process while acting, and never set it here (docs/development.md).
# ACTUATOR_EXPOSED_ENDPOINTS=health,info,metrics,outbox

LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# Kafka's client is loud when the broker is unreachable, and dumps its whole
# configuration at startup. Raise these to see what it is actually doing.
KAFKA_CLIENT_LOG_LEVEL=ERROR
KAFKA_CONFIG_LOG_LEVEL=WARN

# SQL echo, useful while working on a query and noisy the rest of the time.
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
